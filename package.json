{
  "name": "slouch",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/prepare-assets.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.ts",
    "check": "npm test && npm run build",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "assets:audit": "node scripts/audit-assets.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.5.1",
    "@capacitor/ios": "8.5.1",
    "@mediapipe/tasks-vision": "0.10.14",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@fontsource/dm-sans": "5.2.8",
    "@fontsource/fraunces": "5.2.8",
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
